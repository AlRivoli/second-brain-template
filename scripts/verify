#!/usr/bin/env python3
"""Controlla le regole del vault: STATE corti, INDEX coerente, wikilink validi.

Uso: scripts/verify [RADICE_VAULT]
Exit 0 se tutto passa, 1 se trova problemi. Stampa "file: problema" per ogni problema.
Nessun modello, solo lettura dei file.
"""
import json
import pathlib
import re
import sys

MAX_STATE_LINES = 20  # righe non vuote
PRIVATE_DIRS = {'lavoro', '_private'}  # cartelle riservate: non devono stare in INDEX
SKIP_DIRS = {'.git', '.obsidian', '.claude', '.superpowers', 'templates', 'template', 'node_modules'}  # template/: il vault di esempio, ha il suo verify
# Link Obsidian; il pipe può essere escapato come \| dentro le tabelle.
WIKILINK = re.compile(r'\[\[((?:\\\||[^\]])+)\]\]')
INDEX_ROW_START = re.compile(r'^\|\s*\[\[((?:\\\||[^\]])+)\]\]')
INDEX_DATE_END = re.compile(r'(\d{4}-\d{2}-\d{2})\s*\|\s*$')
CODE_SPAN = re.compile(r'`[^`]*`')
UPDATED = re.compile(r'\*\*Aggiornato:\*\*\s*(\d{4}-\d{2}-\d{2})')


def read(path):
    # errors='replace': un file non UTF-8 non deve far fallire il controllo.
    return path.read_text(encoding='utf-8', errors='replace')


def headings(path):
    return [line[3:].strip() for line in read(path).splitlines() if line.startswith('## ')]


def normalize(target):
    # [[projects/x/STATE\\|alias#sezione]] -> projects/x/STATE
    return target.replace('\\|', '|').split('|')[0].split('#')[0].strip()


def project_of(target):
    parts = normalize(target).split('/')
    return parts[1] if parts[0] == 'projects' and len(parts) > 1 else parts[0]


def is_skipped(path, root):
    return any(part in SKIP_DIRS for part in path.relative_to(root).parts)


def check_projects(root, problems):
    template = root / 'templates' / 'STATE.md'
    required = headings(template) if template.exists() else []

    index = root / 'projects' / 'INDEX.md'
    rows = {}
    if not index.exists():
        problems.append('projects/INDEX.md: manca')
    else:
        for number, line in enumerate(read(index).splitlines(), 1):
            start = INDEX_ROW_START.match(line)
            if not start:
                continue
            name = project_of(start.group(1))
            date = INDEX_DATE_END.search(line)
            if not date:
                problems.append(f'projects/INDEX.md:{number}: riga "{name}" senza data')
                rows[name] = None
            else:
                rows[name] = date.group(1)

    projects_dir = root / 'projects'
    folders = []
    if projects_dir.exists():
        folders = sorted(p.name for p in projects_dir.iterdir()
                         if p.is_dir() and not p.name.startswith('.') and p.name not in PRIVATE_DIRS)

    for name in rows:
        if not (projects_dir / name).is_dir():
            problems.append(f'projects/INDEX.md: riga "{name}" senza cartella')
    for name in folders:
        if name not in rows:
            problems.append(f'projects/{name}: cartella non presente in INDEX.md')
        state = projects_dir / name / 'STATE.md'
        rel = f'projects/{name}/STATE.md'
        if not state.exists():
            problems.append(f'{rel}: manca')
            continue
        text = read(state)
        lines = len([line for line in text.splitlines() if line.strip()])
        if lines > MAX_STATE_LINES:
            problems.append(f'{rel}: {lines} righe non vuote, massimo {MAX_STATE_LINES}')
        present = headings(state)
        for heading in required:
            if heading not in present:
                problems.append(f'{rel}: manca la sezione "{heading}"')
        updated = UPDATED.search(text)
        if not updated:
            problems.append(f'{rel}: manca "Aggiornato"')
        elif rows.get(name) and updated.group(1) != rows[name]:
            problems.append(f'{rel}: Aggiornato {updated.group(1)} diverso da INDEX ({rows[name]})')


def check_wikilinks(root, problems):
    # Obsidian risolve per nome di file, senza distinguere maiuscole.
    known = set()
    for p in root.rglob('*'):
        if p.is_file() and not is_skipped(p, root):
            known.add(p.name.lower())
            known.add(p.stem.lower())
            if p.suffix == '.md':
                known.add(p.relative_to(root).with_suffix('').as_posix().lower())
    for path in root.rglob('*.md'):
        if is_skipped(path, root):
            continue
        in_fence = False
        for number, line in enumerate(read(path).splitlines(), 1):
            if line.strip().startswith('```'):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            # Il testo tra backtick è un esempio, non un link.
            for raw in WIKILINK.findall(CODE_SPAN.sub('', line)):
                target = normalize(raw)
                if target.lower() not in known:
                    rel = path.relative_to(root)
                    problems.append(f'{rel}:{number}: wikilink rotto [[{target}]]')


def check_readme(root, problems):
    """Il README deve citare ogni job launchd (second-brain.<nome>, da scripts/jobs.json) e ogni comando di .claude/commands (/<nome>).

    Si controlla solo se esistono il README e la cartella dei job: un vault senza questi file non è obbligato ad averli.
    """
    readme = root / 'README.md'
    jobs = root / 'scripts' / 'jobs.json'
    if not readme.is_file() or not jobs.is_file():
        return
    testo = read(readme)
    for nome in sorted(json.loads(read(jobs))):
        if f'second-brain.{nome}' not in testo:
            problems.append(f'README.md: non cita il job launchd {nome}')
    commands = root / '.claude' / 'commands'
    for comando in sorted(commands.glob('*.md')) if commands.is_dir() else []:
        if f'/{comando.stem}' not in testo:
            problems.append(f'README.md: non cita il comando /{comando.stem}')


def main(argv):
    root = pathlib.Path(argv[1]) if len(argv) > 1 else pathlib.Path(__file__).resolve().parent.parent
    problems = []
    check_projects(root, problems)
    check_wikilinks(root, problems)
    check_readme(root, problems)
    for problem in problems:
        print(problem)
    if problems:
        return 1
    print('OK')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
