{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/daily/**)",
      "Edit(/radar/**)",
      "Edit(/inbox/**)",
      "Edit(/projects/**)",
      "Edit(/content/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(./scripts/verify *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git commit --amend *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Read(/projects/_private/**)",
      "Edit(/projects/_private/**)",
      "Bash(*_private*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/memory/**)",
      "Edit(/docs/adr/**)",
      "Edit(/.claude/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
